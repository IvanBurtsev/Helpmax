{
  "name": "femida-max-bot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "MAX-бот «Фемида AI»: подбор документов. Пока только документация и проверка контента.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "start:poll": "node dist/poll.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check:content": "tsx scripts/check-content.ts",
    "max:check": "tsx scripts/max-check.ts",
    "sim": "tsx scripts/sim.ts",
    "poll": "tsx src/poll.ts",
    "check:db": "tsx scripts/smoke.ts",
    "migrate": "tsx src/migrate.ts",
    "worker": "tsx src/worker.ts"
  },
  "devDependencies": {
    "@types/json-logic-js": "^2.0.8",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@maxhub/max-bot-api": "^1.1.0",
    "bullmq": "^6.7.8",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "json-logic-js": "^2.0.5",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  }
}
