# Скопируйте в .env и заполните. .env в git не попадает.
NODE_ENV=development

# MAX
MAX_BOT_TOKEN=
MAX_API_BASE=https://platform-api2.max.ru
MAX_WEBHOOK_SECRET=

# Хранилища
DATABASE_URL=postgres://user:password@localhost:5432/femida
REDIS_URL=redis://localhost:6379

# Хост-порты для docker compose (если 5432/6379 заняты — задайте другие)
POSTGRES_PORT=5432
REDIS_PORT=6379

# Интеграция с сайтом
SITE_BASE_URL=https://sales.femida-ai.ru
SITE_SERVICE_TOKEN=          # бот -> сайт
INTERNAL_API_TOKEN=          # сайт -> бот
LINK_SIGNING_KEY=

# Контент
CATALOG_PATH=content/catalog.json
SCENARIO_PATH=content/scenarios/example.yaml

# Воркер
WORKER_CONCURRENCY=5
OUTBOX_SWEEP_MS=15000

# Прочее
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
